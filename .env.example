# SensorSphere Supervisor Agent image.
SUPERVISOR_AGENT_IMAGE=ghcr.io/sensorsphere/sensorsphere-supervisor-agent:0.2.0

# Absolute host directory under which managed SensorSphere agent installations live.
# Existing installations can be adopted by choosing their common parent. Example:
#   /home/pi/sensorsphere-device-agent -> SUPERVISOR_MANAGED_ROOT=/home/pi
SUPERVISOR_MANAGED_ROOT=/home/pi

# Default UID/GID written to newly deployed agent .env files when PUID/PGID are
# not supplied explicitly in DEPLOY_AGENT.
SUPERVISOR_DEFAULT_PUID=1000
SUPERVISOR_DEFAULT_PGID=1000

# Local Unix socket shared with SensorSphere agents.
SUPERVISOR_SOCKET_DIR=/run/sensorsphere-supervisor-agent
SUPERVISOR_SOCKET_PATH=/run/sensorsphere-supervisor-agent/supervisor.sock

# Group owning the Unix socket. Set this to the group used by agents that need
# to call the Supervisor.
SUPERVISOR_SOCKET_GID=1000

# Maximum duration of Docker/download operations.
SUPERVISOR_OPERATION_TIMEOUT_MS=120000
