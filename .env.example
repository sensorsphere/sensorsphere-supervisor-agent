# SensorSphere Supervisor Agent image.
SUPERVISOR_AGENT_IMAGE=ghcr.io/sensorsphere/sensorsphere-supervisor-agent:0.1.0

# Absolute path of the existing SensorSphere Device Agent installation on the host.
DEVICE_AGENT_INSTALL_DIR=/home/pi/sensorsphere-device-agent

# Local Unix socket shared with the Device Agent.
SUPERVISOR_SOCKET_DIR=/run/sensorsphere-supervisor-agent
SUPERVISOR_SOCKET_PATH=/run/sensorsphere-supervisor-agent/supervisor.sock

# Group owning the Unix socket. Set this to the Device Agent PGID.
SUPERVISOR_SOCKET_GID=1000

# Managed image/repository are fixed locally and cannot be overridden by update requests.
SUPERVISOR_MANAGED_IMAGE=ghcr.io/sensorsphere/sensorsphere-device-agent
SUPERVISOR_COMPOSE_SOURCE_URL_TEMPLATE=https://raw.githubusercontent.com/sensorsphere/sensorsphere-device-agent/v{version}/docker-compose.yml
SUPERVISOR_UPDATE_TIMEOUT_MS=120000
