# SensorSphere Supervisor Agent image.
SUPERVISOR_AGENT_IMAGE=ghcr.io/sensorsphere/sensorsphere-supervisor-agent:0.8.2

# Deployment environment. DIT/IAT/PROD instances can coexist on one host;
# scripts/install.sh derives an isolated runtime namespace from this value.
SENSORSPHERE_ENVIRONMENT=DEFAULT
COMPOSE_PROJECT_NAME=sensorsphere-default-supervisor

# Optional direct outbound connection to SensorSphere. Configure both values to
# make the Supervisor independently visible/manageable without a Device Agent relay.
#SENSORSPHERE_URL=http://100.64.0.8:8080
#SENSORSPHERE_AGENT_TOKEN=sssa_replace_me
#SUPERVISOR_NAME=host-supervisor
# Host OS hostname injected into the container so os.hostname() reports the real host.
# Normally maintained automatically by scripts/install.sh.
#SUPERVISOR_HOSTNAME=host-real-name
#SENSORSPHERE_HEARTBEAT_INTERVAL_MS=30000

# Absolute host directory under which managed SensorSphere agent installations live.
# Existing installations can be adopted by choosing their common parent. Example:
#   /home/pi/sensorsphere-device-agent -> SUPERVISOR_MANAGED_ROOT=/home/pi
# Optional second absolute root for explicit SensorSphere associations outside
# the normal user home layout. It is mounted into the Supervisor at the same path.
SUPERVISOR_ADDITIONAL_MANAGED_ROOT=/opt
SUPERVISOR_MANAGED_ROOT=/home/pi
# Optional second absolute root for explicit SensorSphere associations outside
# the normal user home layout. It is mounted into the Supervisor at the same path.
SUPERVISOR_ADDITIONAL_MANAGED_ROOT=/opt

# Default UID/GID written to newly deployed agent .env files when PUID/PGID are
# not supplied explicitly in DEPLOY_AGENT.
SUPERVISOR_DEFAULT_PUID=1000
SUPERVISOR_DEFAULT_PGID=1000

# Local Unix socket shared with SensorSphere agents.
SUPERVISOR_SOCKET_DIR=/run/sensorsphere-supervisor-agent
SUPERVISOR_SOCKET_PATH=/run/sensorsphere-supervisor-agent/supervisor.sock

# Group owning the Unix socket. Set this to the group used by agents that need
# to call the Supervisor.
SUPERVISOR_SOCKET_GID=1000

# Maximum duration of Docker/download operations.
SUPERVISOR_OPERATION_TIMEOUT_MS=600000

# Supervisor self-update. The install directory defaults to
# <SUPERVISOR_MANAGED_ROOT>/sensorsphere-supervisor-agent.
SUPERVISOR_SELF_INSTALL_DIR=/home/pi/sensorsphere-supervisor-agent
SUPERVISOR_SELF_UPDATE_TIMEOUT_MS=120000
